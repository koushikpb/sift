# .env.demo.example — copy to .env for the Anthropic-powered demo. .env is gitignored.
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.anthropic.com/v1/
LLM_MODEL=claude-sonnet-4-6
LLM_API_KEY=            # Anthropic API key — server-side only, never commit
LLM_MAX_TOKENS=1024
DATABASE_URL=
# PLAYBOOK_PATH — override for core/src/agent/index.ts's playbook resolution. app/next.config.mjs
# already computes and injects a working default for the Next app (both local dev and the
# deployed Vercel function), so you normally don't need to set this by hand. Only set it if the
# review demo's /api/review route 500s with "insufficient server configuration" and server logs
# point at playbook resolution — e.g. a deployment layout where the auto-computed path doesn't
# resolve. Verified: core/src/agent/index.ts's own import.meta.url-based fallback throws
# `Invalid URL` once webpack bundles it (Next rewrites `new URL(literal, import.meta.url)` into a
# static-asset reference) — this env var is how you route around that if the default ever fails.
PLAYBOOK_PATH=
