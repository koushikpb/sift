# .env.demo.example — copy to .env for the Anthropic-powered demo. .env is gitignored.
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.anthropic.com/v1/
LLM_MODEL=claude-sonnet-4-6
LLM_API_KEY=            # Anthropic API key — server-side only, never commit
LLM_MAX_TOKENS=1024
DATABASE_URL=
# Retrieval strategy (core/src/retrieve): naive|hybrid|agentic. hybrid = dense+lexical+rerank —
# what the README architecture describes; this is the demo's intended mode.
RETRIEVE_MODE=hybrid
# PLAYBOOK_PATH — explicit override for playbook resolution (resolvePlaybookPath in
# core/src/agent/index.ts). Normally leave unset: the resolver auto-finds
# evals/playbook/nda.yaml via cwd-relative probes (`evals/...`, then `../evals/...`), which
# covers local dev (Next runs with cwd = app/) and the deployed Vercel function (the YAML ships
# with the function via outputFileTracingIncludes, preserving the repo-relative layout; the
# function cwd is the function root or app/ within it). Set an absolute path only if /api/review
# 500s with "insufficient server configuration" and server logs point at playbook resolution —
# i.e. a deployment layout where neither cwd probe lands on the file.
PLAYBOOK_PATH=

# --- Rate limiting + hardening (Task 9) -----------------------------------------------------
# Per-IP requests/minute, enforced independently on /api/review, /api/memo
# (app/src/lib/rateLimit.ts). Sane default below; raise/lower per deploy without a code change.
RATE_LIMIT_RPM=10
# Max simultaneous in-flight /api/review streams per server instance (bounds Anthropic spend —
# each allowed request costs real money). In-process only; not shared across instances.
REVIEW_MAX_CONCURRENCY=2
# Optional: Upstash Redis REST creds. When both are set, rate limiting uses a durable,
# cross-instance @upstash/ratelimit store instead of the in-process fallback (which only budgets
# per server instance — fine for this single-instance demo, but on Vercel each warm function
# instance would otherwise enforce its own independent RATE_LIMIT_RPM). Set at deploy time
# (Task 11); leave blank for local dev.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
